# Copy to .env (gitignored). Generate fresh values, never reuse these placeholders.
#   ENCRYPTION_KEY:  openssl rand -hex 16
#   AUTH_SECRET:     openssl rand -base64 32
#   POSTGRES_PASSWORD: openssl rand -hex 16
ENCRYPTION_KEY=
AUTH_SECRET=
POSTGRES_USER=infisical
POSTGRES_PASSWORD=
POSTGRES_DB=infisical

DB_CONNECTION_URI=postgres://infisical:<POSTGRES_PASSWORD>@db:5432/infisical
REDIS_URL=redis://redis:6379
# Public URL of this instance (tailnet/ingress hostname).
SITE_URL=https://homelab.example.ts.net:8443